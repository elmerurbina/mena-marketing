---
import ArtFrame from './ArtFrame.astro';
import type { Project } from '../lib/types';

interface Props {
	project: Project;
	index: number;
	tall?: boolean;
}
const { project, index, tall = false } = Astro.props;
const cover = project.cover_url;
const alt = project.photos?.[0]?.alt_text || project.title;
---

<a
	href={`/portafolio/${project.slug}`}
	class:list={['proj-card', { 'proj-card--tall': tall }]}
	data-category={project.category?.slug ?? ''}
	data-cursor="Ver proyecto"
>
	<div class="proj-media" data-img-reveal>
		<div class="proj-media-inner">
			{
				cover ? (
					<img
						src={cover}
						alt={alt}
						loading={index < 2 ? 'eager' : 'lazy'}
						decoding="async"
						onerror="this.style.display='none';this.parentElement.classList.add('img-failed')"
					/>
				) : (
					<ArtFrame seed={index + 2} />
				)
			}
		</div>
	</div>
	<div class="proj-meta">
		<div>
			<h3 class="proj-title">{project.title}</h3>
			{project.client && <p class="proj-client">{project.client}</p>}
		</div>
		{project.category && <span class="badge">{project.category.name}</span>}
	</div>
</a>

<style>
	.proj-card {
		display: grid;
		gap: 18px;
	}
	.proj-media {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--surface);
	}
	.proj-card--tall .proj-media {
		aspect-ratio: 3 / 4.4;
	}
	.proj-media-inner {
		position: absolute;
		inset: 0;
	}
	.proj-media img,
	.proj-media :global(.art) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1.6s var(--ease-lux), filter 1s;
		filter: saturate(0.9);
	}
	.proj-card:hover .proj-media img,
	.proj-card:hover .proj-media :global(.art) {
		transform: scale(1.06);
		filter: saturate(1.05);
	}
	.proj-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 55%, rgba(7, 6, 10, 0.55));
		pointer-events: none;
	}
	:global(.img-failed) {
		background: var(--purple-gradient);
	}
	.proj-meta {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 16px;
	}
	.proj-title {
		font-size: clamp(1.4rem, 2.2vw, 1.9rem);
		transition: color 0.4s;
	}
	.proj-card:hover .proj-title {
		color: var(--gold-light);
	}
	.proj-client {
		margin: 4px 0 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
