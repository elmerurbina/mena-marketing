---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { back, friendlyDbError, getFile, removeFromStorage, storagePathFromUrl, uploadImage } from '../../lib/admin';
import { EMAIL_RE, bool, field } from '../../lib/utils';
import { defaultSettings } from '../../lib/content';
import type { Settings } from '../../lib/types';

const sb = Astro.locals.supabase!;
const { data } = await sb.from('company_settings').select('*').eq('id', 1).maybeSingle();
const s = { ...defaultSettings, ...(data ?? {}) } as Settings;

const url = (v: string) => {
	if (!v) return null;
	try {
		const u = new URL(v);
		return u.protocol === 'https:' || u.protocol === 'http:' ? u.href : null;
	} catch {
		return null;
	}
};
const num = (v: string) => (v && Number.isFinite(Number(v)) && Number(v) >= 0 ? Math.round(Number(v)) : null);

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const email = field(form, 'email', 160);
	if (email && !EMAIL_RE.test(email)) return back(Astro.url, { err: 'El correo electrónico no es válido.' });

	const socials = ['instagram', 'facebook', 'tiktok', 'linkedin', 'youtube'] as const;
	const invalid = socials.find((k) => field(form, k, 300) && !url(field(form, k, 300)));
	if (invalid) return back(Astro.url, { err: `El enlace de ${invalid} debe ser una URL completa (https://…).` });

	const payload: Record<string, unknown> = {
		name: field(form, 'name', 120) || 'MENA Marketing',
		tagline: field(form, 'tagline', 160) || null,
		description: field(form, 'description', 600) || null,
		hero_title: field(form, 'hero_title', 120) || null,
		hero_subtitle: field(form, 'hero_subtitle', 300) || null,
		email: email || null,
		phone: field(form, 'phone', 40) || null,
		whatsapp: field(form, 'whatsapp', 30).replace(/[^\d+]/g, '') || null,
		whatsapp_message: field(form, 'whatsapp_message', 300) || null,
		address: field(form, 'address', 300) || null,
		stat_projects: num(field(form, 'stat_projects', 10)),
		stat_clients: num(field(form, 'stat_clients', 10)),
		stat_years: num(field(form, 'stat_years', 10)),
		hero_image: s.hero_image,
	};
	for (const k of socials) payload[k] = url(field(form, k, 300));

	if (bool(form, 'remove_hero')) payload.hero_image = null;
	const file = getFile(form, 'hero_image');
	if (file) {
		const up = await uploadImage(sb, file, 'site');
		if ('error' in up) return back(Astro.url, { err: up.error });
		payload.hero_image = up.url;
	}

	const { error } = await sb.from('company_settings').update(payload).eq('id', 1);
	if (error) return back(Astro.url, { err: friendlyDbError(error) });
	if (s.hero_image && s.hero_image !== payload.hero_image) await removeFromStorage(sb, [storagePathFromUrl(s.hero_image)]);
	return back(Astro.url, { ok: 'Información de la empresa actualizada.' });
}
---

<AdminLayout title="Empresa y contacto">
	<div class="page-head">
		<div>
			<p class="crumbs"><a href="/admin">Panel</a> / Empresa y contacto</p>
			<h1>Empresa y contacto</h1>
			<p>Datos que se muestran en todo el sitio: encabezado, pie de página, contacto y WhatsApp.</p>
		</div>
	</div>

	<form method="post" enctype="multipart/form-data">
		<section class="card form">
			<h2 class="card-title">Identidad</h2>
			<div class="form-grid">
				<div class="f"><label for="name">Nombre comercial</label><input id="name" name="name" type="text" value={s.name} /></div>
				<div class="f"><label for="tagline">Lema</label><input id="tagline" name="tagline" type="text" value={s.tagline} /></div>
				<div class="f span-2"><label for="description">Descripción (SEO y pie de página)</label><textarea id="description" name="description" rows="3">{s.description}</textarea></div>
			</div>
		</section>

		<section class="card form">
			<h2 class="card-title">Portada (hero)</h2>
			<div class="form-grid">
				<div class="f"><label for="hero_title">Título principal</label><input id="hero_title" name="hero_title" type="text" value={s.hero_title} /><small>La primera palabra se muestra en blanco y el resto en dorado.</small></div>
				<div class="f"><label for="hero_subtitle">Subtítulo</label><input id="hero_subtitle" name="hero_subtitle" type="text" value={s.hero_subtitle} /></div>
				<div class="f span-2">
					<span class="f-label">Imagen de portada (opcional)</span>
					{s.hero_image && <img class="preview-img" src={s.hero_image} alt="" />}
					<input type="file" name="hero_image" accept="image/jpeg,image/png,image/webp,image/avif" data-optimize />
					<small data-optimize-note>Si no hay imagen, se muestra el emblema dorado animado.</small>
					{s.hero_image && <label class="check"><input type="checkbox" name="remove_hero" /> Quitar imagen</label>}
				</div>
			</div>
		</section>

		<section class="card form">
			<h2 class="card-title">Contacto</h2>
			<div class="form-grid">
				<div class="f"><label for="email">Correo</label><input id="email" name="email" type="email" value={s.email ?? ''} /></div>
				<div class="f"><label for="phone">Teléfono</label><input id="phone" name="phone" type="tel" value={s.phone ?? ''} /></div>
				<div class="f"><label for="whatsapp">WhatsApp (con código de país)</label><input id="whatsapp" name="whatsapp" type="tel" value={s.whatsapp ?? ''} placeholder="+505 8888 8888" /><small>Si queda vacío, el botón de WhatsApp se oculta.</small></div>
				<div class="f"><label for="whatsapp_message">Mensaje predeterminado de WhatsApp</label><input id="whatsapp_message" name="whatsapp_message" type="text" value={s.whatsapp_message ?? ''} /></div>
				<div class="f span-2"><label for="address">Dirección</label><input id="address" name="address" type="text" value={s.address ?? ''} /></div>
			</div>
		</section>

		<section class="card form">
			<h2 class="card-title">Redes sociales oficiales</h2>
			<div class="form-grid">
				{(['instagram', 'facebook', 'tiktok', 'linkedin', 'youtube'] as const).map((k) => (
					<div class="f"><label for={k}>{k}</label><input id={k} name={k} type="url" value={s[k] ?? ''} placeholder="https://" /></div>
				))}
			</div>
		</section>

		<section class="card form">
			<h2 class="card-title">Cifras (opcional)</h2>
			<p class="muted" style="margin:0">Si se completan, se muestran con un contador animado en la página de inicio. Usa solo cifras verificables.</p>
			<div class="form-grid">
				<div class="f"><label for="stat_projects">Proyectos realizados</label><input id="stat_projects" name="stat_projects" type="number" min="0" value={s.stat_projects ?? ''} /></div>
				<div class="f"><label for="stat_clients">Marcas acompañadas</label><input id="stat_clients" name="stat_clients" type="number" min="0" value={s.stat_clients ?? ''} /></div>
				<div class="f"><label for="stat_years">Años de experiencia</label><input id="stat_years" name="stat_years" type="number" min="0" value={s.stat_years ?? ''} /></div>
			</div>
			<div class="form-actions"><button class="btn btn-primary" type="submit">Guardar todo</button></div>
		</section>
	</form>
</AdminLayout>
