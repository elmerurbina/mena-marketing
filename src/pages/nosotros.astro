---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import LogoMark from '../components/LogoMark.astro';
import Icon from '../components/Icon.astro';
import { getInstitutional, getServices, getSettings } from '../lib/content';

const sb = Astro.locals.supabase;
const [settings, blocks, services] = await Promise.all([getSettings(sb), getInstitutional(sb), getServices(sb)]);
const [first, ...rest] = blocks;
---

<SiteLayout
	settings={settings}
	title="Nosotros"
	description={`Conoce a ${settings.name}: ${settings.description}`}
>
	<PageHero
		eyebrow="Nosotros"
		title={`Creatividad con <span class="italic text-gold">propósito</span>`}
		lead={settings.description}
	/>

	<section class="section about">
		<div class="container about-grid">
			<div class="about-visual" data-img-reveal>
				<div class="about-visual-inner">
					<div class="about-emblem" data-parallax="0.1"><LogoMark variant="purple" title="" /></div>
					<div class="about-emblem-gold"><LogoMark variant="wire-gold" title="" /></div>
				</div>
			</div>

			<div class="about-copy">
				{
					first && (
						<>
							<p class="eyebrow" data-reveal>{first.title}</p>
							<h2 class="display-md" data-split>{first.body}</h2>
						</>
					)
				}
			</div>
		</div>
	</section>

	{
		rest.length > 0 && (
			<section class="section section--tight values">
				<div class="container">
					<div class="values-grid">
						{rest.map((b, i) => (
							<article class="value" data-reveal>
								<span class="value-num">0{i + 1}</span>
								<h3 class="display-sm">{b.title}</h3>
								<hr class="hairline" data-line />
								<p>{b.body}</p>
							</article>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section expertise">
		<div class="container">
			<div class="section-head section-head--split">
				<div>
					<p class="eyebrow" data-reveal>Especialidades</p>
					<h2 class="display-lg" data-split>Todo lo que tu marca <span class="italic text-gold">necesita</span></h2>
				</div>
				<p class="muted" data-reveal>Integramos estrategia, creatividad y producción para que cada pieza de comunicación trabaje a favor de tu marca.</p>
			</div>
			<ul class="exp-list">
				{
					services.map((s, i) => (
						<li data-reveal>
							<a href={`/servicios/${s.slug}`} class="exp-row" data-cursor="Ver">
								<span class="exp-num">0{i + 1}</span>
								<span class="exp-name display-md">{s.name}</span>
								<span class="exp-summary">{s.summary}</span>
								<span class="exp-arrow"><Icon name="arrow-up-right" size={22} /></span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</SiteLayout>

<style>
	.about-grid {
		display: grid;
		gap: clamp(50px, 7vw, 110px);
		align-items: center;
	}
	@media (min-width: 960px) {
		.about-grid {
			grid-template-columns: 0.85fr 1.15fr;
		}
	}
	.about-visual {
		aspect-ratio: 4 / 5;
		border-radius: 999px 999px var(--radius) var(--radius);
		overflow: hidden;
		border: 1px solid var(--line-strong);
		background: radial-gradient(80% 60% at 50% 30%, rgba(109, 40, 217, 0.45), transparent 70%), var(--ink-2);
	}
	.about-visual-inner {
		position: relative;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
	}
	.about-emblem {
		width: 62%;
		filter: drop-shadow(0 30px 60px rgba(109, 40, 217, 0.5));
	}
	.about-emblem-gold {
		position: absolute;
		width: 40%;
		right: 6%;
		bottom: 8%;
		opacity: 0.6;
	}
	.about-copy {
		display: grid;
		gap: 28px;
	}
	.about-copy h2 {
		line-height: 1.15;
	}
	.values-grid {
		display: grid;
		gap: clamp(36px, 5vw, 70px);
	}
	@media (min-width: 760px) {
		.values-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}
	.value {
		display: grid;
		gap: 18px;
		align-content: start;
	}
	.value-num {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--gold);
		font-size: 1.2rem;
	}
	.value p {
		margin: 0;
		color: var(--text-soft);
	}
	.exp-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.exp-row {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px 28px;
		padding: clamp(24px, 3vw, 40px) 0;
		border-bottom: 1px solid var(--line);
		overflow: hidden;
	}
	.exp-row::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(109, 40, 217, 0.18), rgba(212, 175, 55, 0.08));
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 0.8s var(--ease-lux);
		z-index: -1;
	}
	.exp-row:hover::before {
		transform: scaleY(1);
	}
	.exp-num {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: var(--gold);
	}
	.exp-name {
		transition: transform 0.8s var(--ease-lux), color 0.5s;
	}
	.exp-row:hover .exp-name {
		transform: translateX(16px);
		color: var(--gold-light);
	}
	.exp-summary {
		grid-column: 2 / 3;
		color: var(--muted);
		font-size: 0.95rem;
		max-width: 52ch;
	}
	.exp-arrow {
		grid-row: 1 / 3;
		grid-column: 3;
		color: var(--gold);
		transition: transform 0.8s var(--ease-lux);
	}
	.exp-row:hover .exp-arrow {
		transform: rotate(45deg);
	}
	@media (min-width: 960px) {
		.exp-row {
			grid-template-columns: 60px 1.1fr 1fr 40px;
		}
		.exp-summary {
			grid-column: 3;
		}
		.exp-arrow {
			grid-row: auto;
			grid-column: 4;
		}
	}
</style>
