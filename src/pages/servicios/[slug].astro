---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import Icon from '../../components/Icon.astro';
import { getService, getServices, getSettings } from '../../lib/content';
import { whatsappLink } from '../../lib/utils';

const sb = Astro.locals.supabase;
const slug = Astro.params.slug ?? '';
const [settings, service, all] = await Promise.all([getSettings(sb), getService(sb, slug), getServices(sb)]);
if (!service) return Astro.rewrite('/404');

const idx = all.findIndex((s) => s.id === service.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
const wa = whatsappLink(settings, `Hola MENA Marketing, me interesa el servicio de ${service.name}.`);
---

<SiteLayout settings={settings} title={service.name} description={service.summary} image={service.image_url}>
	<section class="svc-hero">
		<div class="orb orb--purple svc-orb" aria-hidden="true"></div>
		<div class="container svc-hero-inner">
			<a href="/servicios" class="back" data-hero><Icon name="chevron-left" size={16} /> Servicios</a>
			<p class="eyebrow" data-hero>Servicio {String(idx + 1).padStart(2, '0')}</p>
			<h1 class="display-xl" data-split="hero">{service.name}</h1>
			<p class="lead" data-hero>{service.summary}</p>
		</div>
	</section>

	<div class="container">
		<div class="svc-cover" data-hero-media>
			{
				service.image_url ? (
					<img src={service.image_url} alt={service.name} data-parallax="0.08" />
				) : (
					<ArtFrame seed={idx} label={service.name} />
				)
			}
		</div>
	</div>

	<section class="section">
		<div class="container svc-detail">
			<div>
				<p class="eyebrow" data-reveal>En detalle</p>
			</div>
			<div class="svc-detail-body">
				<p class="display-sm svc-description" data-reveal>{service.description || service.summary}</p>

				{
					service.features && service.features.length > 0 && (
						<ul class="features">
							{service.features.map((f) => (
								<li data-reveal>
									<span class="feature-icon"><Icon name="check" size={16} /></span>
									{f}
								</li>
							))}
						</ul>
					)
				}

				<div class="svc-actions" data-reveal>
					<a href={`/contacto?servicio=${service.slug}`} class="btn btn--gold" data-magnetic>
						Solicitar cotización <Icon name="arrow" size={16} class="btn-arrow" />
					</a>
					{wa && (<a href={wa} target="_blank" rel="noopener" class="btn" data-magnetic><Icon name="whatsapp" size={18} /> WhatsApp</a>)}
				</div>
				<p class="disclaimer" data-reveal>
					El envío de una solicitud no representa una contratación. Las condiciones, precios y disponibilidad se comunican directamente por {settings.name}.
				</p>
			</div>
		</div>
	</section>

	{
		next && (
			<a href={`/servicios/${next.slug}`} class="next-svc" data-cursor="Siguiente">
				<div class="container">
					<span class="eyebrow">Siguiente servicio</span>
					<span class="display-lg next-name">{next.name}</span>
				</div>
			</a>
		)
	}
</SiteLayout>

<style>
	.svc-hero {
		position: relative;
		overflow: hidden;
		padding-top: calc(var(--header-h) + clamp(60px, 9vw, 130px));
		padding-bottom: clamp(50px, 7vw, 90px);
	}
	.svc-orb {
		width: 50vw;
		height: 50vw;
		right: -10vw;
		top: -15vw;
		opacity: 0.4;
	}
	.svc-hero-inner {
		position: relative;
		display: grid;
		gap: 26px;
	}
	.svc-hero-inner h1 {
		max-width: 13ch;
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--muted);
		transition: color 0.4s;
	}
	.back:hover {
		color: var(--gold);
	}
	.svc-cover {
		aspect-ratio: 16 / 8;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--line);
	}
	@media (max-width: 700px) {
		.svc-cover {
			aspect-ratio: 4 / 3;
		}
	}
	.svc-cover img {
		width: 100%;
		height: 120%;
		object-fit: cover;
	}
	.svc-detail {
		display: grid;
		gap: 30px;
	}
	@media (min-width: 900px) {
		.svc-detail {
			grid-template-columns: 0.35fr 1fr;
		}
	}
	.svc-detail-body {
		display: grid;
		gap: 44px;
	}
	.svc-description {
		line-height: 1.35;
		color: var(--text);
	}
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
		border-top: 1px solid var(--line);
	}
	@media (min-width: 700px) {
		.features {
			grid-template-columns: 1fr 1fr;
			column-gap: 40px;
		}
	}
	.features li {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
		font-size: 1.05rem;
	}
	.feature-icon {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		color: var(--gold);
		flex-shrink: 0;
	}
	.svc-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}
	.disclaimer {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
		max-width: 60ch;
	}
	.next-svc {
		display: block;
		padding-block: clamp(70px, 10vw, 140px);
		border-top: 1px solid var(--line);
		background: linear-gradient(180deg, transparent, rgba(109, 40, 217, 0.12));
		transition: background 0.8s;
	}
	.next-svc .container {
		display: grid;
		gap: 18px;
	}
	.next-name {
		transition: transform 1s var(--ease-lux), color 0.6s;
	}
	.next-svc:hover .next-name {
		transform: translateX(24px);
		color: var(--gold-light);
	}
</style>
