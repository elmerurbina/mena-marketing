---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import { getServices, getSettings } from '../../lib/content';

const sb = Astro.locals.supabase;
const [settings, services] = await Promise.all([getSettings(sb), getServices(sb)]);
---

<SiteLayout settings={settings} title="Servicios" description="Asesoría de marketing, gestión de redes sociales, creación de contenido, fotografía profesional y publicidad.">
	<PageHero
		eyebrow="Servicios"
		title={`Soluciones que <span class="italic text-gold">elevan</span> tu marca`}
		lead="Estrategia, contenido y fotografía profesional reunidos en un mismo equipo creativo."
	/>

	<section class="section section--tight">
		<div class="container">
			{
				services.length ? (
					<div class="svc-grid">
						{services.map((s, i) => (
							<div data-reveal>
								<ServiceCard service={s} index={i} />
							</div>
						))}
					</div>
				) : (
					<div class="empty" data-reveal>
						<p class="display-sm">Estamos preparando nuestro catálogo de servicios.</p>
						<p class="muted">Mientras tanto, cuéntanos qué necesitas y te responderemos personalmente.</p>
						<a href="/contacto" class="btn">Contáctanos</a>
					</div>
				)
			}

			<div class="svc-note" data-reveal>
				<p>¿No encuentras exactamente lo que buscas? Diseñamos propuestas a la medida de cada marca.</p>
				<a href="/contacto" class="btn btn--gold" data-magnetic>Solicitar cotización <Icon name="arrow" size={16} class="btn-arrow" /></a>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.svc-grid {
		display: grid;
		gap: clamp(20px, 2.6vw, 34px);
	}
	@media (min-width: 700px) {
		.svc-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1100px) {
		.svc-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.svc-grid > div {
		height: 100%;
	}
	.svc-note {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: clamp(60px, 8vw, 110px);
		padding: clamp(28px, 4vw, 48px);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: linear-gradient(120deg, rgba(109, 40, 217, 0.16), rgba(212, 175, 55, 0.06));
	}
	.svc-note p {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.4vw, 2rem);
		max-width: 30ch;
		line-height: 1.2;
	}
	.empty {
		display: grid;
		gap: 16px;
		justify-items: start;
		padding: 60px 0;
	}
</style>
